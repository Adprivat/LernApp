      "Bash(node .claude/get-shit-done/bin/gsd-tools.cjs verify plan-structure \".planning/phases/03-auth-security-fix/03-01-PLAN.md\")",
      "Bash(node .claude/get-shit-done/bin/gsd-tools.cjs verify plan-structure \".planning/phases/03-auth-security-fix/03-02-PLAN.md\")",
      "Bash(node .claude/get-shit-done/bin/gsd-tools.cjs commit \"docs\\(03\\): create phase plans for auth security fix\" --files .planning/phases/03-auth-security-fix/03-01-PLAN.md .planning/phases/03-auth-security-fix/03-02-PLAN.md .planning/ROADMAP.md)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
